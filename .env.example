# ==========================================================
# AI Study Assistant - Environment Variables Template (.env.example)
# ==========================================================
# Duplicate this file as '.env' and populate with your credentials.
# NEVER commit your actual '.env' file to GitHub or public repositories.

# Google Gemini AI API Keys (Triple Fallback System)
# If Key 1 fails or hits quota, it automatically falls back to Key 2, then Key 3!
GEMINI_API_KEY_1=AIzaSyYourFirstGeminiApiKeyHere
GEMINI_API_KEY_2=AIzaSyYourSecondGeminiApiKeyHere
GEMINI_API_KEY_3=AIzaSyYourThirdGeminiApiKeyHere

# Firebase Web Configuration
# (Found in Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=data-base-of-study-assitant.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=data-base-of-study-assitant
VITE_FIREBASE_STORAGE_BUCKET=data-base-of-study-assitant.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=614569134909
VITE_FIREBASE_APP_ID=1:614569134909:web:553a92a01a37724edd9354
VITE_FIREBASE_MEASUREMENT_ID=G-WVJSQWC6BG

# Project Metadata
VITE_PROJECT_NAME="Data Base Of study Assitant"
VITE_SUPPORT_EMAIL=your-support-email@example.com
